APP_STORAGE_ROOT=/tmp/ct-early-response

# Local default:
# DATABASE_URL=sqlite:////tmp/ct-early-response/workflow.db
#
# Render free Postgres example:
# DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/DBNAME

ORTHANC_URL=
DICOMWEB_BASE_URL=
OHIF_BASE_URL=
SMART_FHIR_ISSUER=
SMART_CLIENT_ID=
EPIC_BASE_URL=
FHIRCAST_HUB_URL=
DEPLOYMENT_MODE=local-or-cloud

# Open-source report dictation.
# Leave disabled on free Render unless you provide a small local model/binary.
STT_PROVIDER=disabled
WHISPER_CPP_BINARY=whisper-cli
WHISPER_CPP_MODEL=
FFMPEG_BINARY=ffmpeg
STT_TIMEOUT_SECONDS=120
